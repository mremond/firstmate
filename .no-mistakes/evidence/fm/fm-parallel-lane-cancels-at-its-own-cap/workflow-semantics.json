{
  "semantic_workflow_unchanged": true,
  "parallel_jobs": {
    "tests-portable-parallel-1": {
      "name": "Behavior portable parallel 1",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 10,
      "steps": [
        {
          "uses": "actions/checkout@v6",
          "with": {
            "fetch-depth": 0
          }
        },
        {
          "name": "Install pinned ShellCheck",
          "run": "set -eu\nbin/fm-install-shellcheck.sh \"$RUNNER_TEMP/bin\"\necho \"$RUNNER_TEMP/bin\" >> \"$GITHUB_PATH\"\n"
        },
        {
          "name": "Install pinned actionlint",
          "run": "set -eu\nbin/fm-install-actionlint.sh \"$RUNNER_TEMP/bin\"\necho \"$RUNNER_TEMP/bin\" >> \"$GITHUB_PATH\"\n"
        },
        {
          "name": "Install tasks-axi",
          "run": "set -eu\nnpm install -g tasks-axi\ntasks-axi --version\n"
        },
        {
          "name": "Install the Pi package for the Pi extension tests",
          "run": "set -eu\nnpm install -g @earendil-works/pi-coding-agent\nnpm ls -g --depth 0 @earendil-works/pi-coding-agent\n"
        },
        {
          "name": "Run portable parallel shard 1",
          "run": "set -eu\nmkdir -p \"$RUNNER_TEMP/fm-test\"\nbin/fm-test-run.sh --lane portable-parallel-1 \\\n  --fail-on-gate-skip 'Pi extension typecheck prerequisite not found' \\\n  --json \"$RUNNER_TEMP/fm-test/fm-test-timing-portable-parallel-1.json\"\n"
        },
        {
          "name": "Upload shard 1 timing artifact",
          "if": "always()",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "fm-test-timing-portable-parallel-1",
            "path": "${{ runner.temp }}/fm-test/fm-test-timing-portable-parallel-1.json",
            "if-no-files-found": "warn"
          }
        }
      ]
    },
    "tests-portable-parallel-2": {
      "name": "Behavior portable parallel 2",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 10,
      "steps": [
        {
          "uses": "actions/checkout@v6",
          "with": {
            "fetch-depth": 0
          }
        },
        {
          "name": "Install pinned ShellCheck",
          "run": "set -eu\nbin/fm-install-shellcheck.sh \"$RUNNER_TEMP/bin\"\necho \"$RUNNER_TEMP/bin\" >> \"$GITHUB_PATH\"\n"
        },
        {
          "name": "Install pinned actionlint",
          "run": "set -eu\nbin/fm-install-actionlint.sh \"$RUNNER_TEMP/bin\"\necho \"$RUNNER_TEMP/bin\" >> \"$GITHUB_PATH\"\n"
        },
        {
          "name": "Install tasks-axi",
          "run": "set -eu\nnpm install -g tasks-axi\ntasks-axi --version\n"
        },
        {
          "name": "Run portable parallel shard 2",
          "run": "set -eu\nmkdir -p \"$RUNNER_TEMP/fm-test\"\nbin/fm-test-run.sh --lane portable-parallel-2 \\\n  --json \"$RUNNER_TEMP/fm-test/fm-test-timing-portable-parallel-2.json\"\n"
        },
        {
          "name": "Upload shard 2 timing artifact",
          "if": "always()",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "fm-test-timing-portable-parallel-2",
            "path": "${{ runner.temp }}/fm-test/fm-test-timing-portable-parallel-2.json",
            "if-no-files-found": "warn"
          }
        }
      ]
    }
  },
  "scope": "Parsed YAML equivalence only; no GitHub job started or rerun."
}
