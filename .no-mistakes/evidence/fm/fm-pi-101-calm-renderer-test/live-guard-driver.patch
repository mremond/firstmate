+    assert_not_contains "$(cat "$TMP_ROOT/remapped-enter.txt")" "Session exported to:" "non-submit Enter performed export"
+  done
+  assert_contains "$(cat "$TMP_ROOT/remapped-enter.txt")" "/export $export_file" "non-submit Enter consumed the editor command"
+  pass "live remapped Enter leaves the export command in the editor, writes no HTML, and keeps tool output hidden"
   tmux -L "$TMUX_SOCKET" send-keys -t "$TMUX_SESSION" M-s
   wait_for_text "$export_snapshot" "Session exported to: $export_file" \
     || fail "/export did not complete while calm mode was on"
